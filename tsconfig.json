{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "dupes/**/*.ts",
    "scripts/**/*.ts",
    "packages/platform/**/*.ts"
  ]
}
